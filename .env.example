APP_ENV=production
ALLOWED_ORIGINS=https://diariomercantil.com
FRONTEND_URL=https://diariomercantil.com

DB_DATABASE=diario_mercantil
DB_USERNAME=mercantil_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

UPLOAD_DIR=/var/www/html/storage/uploads
RESULT_DIR=/var/www/html/storage/results
MAX_FILE_MB=50
HEALTH_MIN_DISK_BYTES=524288000

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=smtps
SMTP_USER=correo@tu-dominio.com
SMTP_PASS=CHANGE_ME_AND_ROTATE_THE_OLD_CREDENTIAL
SMTP_FROM=correo@tu-dominio.com
SMTP_FROM_NAME=Diario Mercantil
