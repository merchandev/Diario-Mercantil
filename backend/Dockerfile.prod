FROM php:8.4-fpm-alpine

RUN apk add --no-cache \
      curl \
      curl-dev \
      freetype-dev \
      icu-dev \
      libjpeg-turbo-dev \
      libpng-dev \
      libxml2-dev \
      libzip-dev \
      mysql-client \
      oniguruma-dev \
      poppler-utils \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql gd zip mbstring curl opcache intl

WORKDIR /var/www/html

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
COPY composer.json composer.lock ./
RUN composer install \
      --no-dev \
      --prefer-dist \
      --no-interaction \
      --no-progress \
      --no-autoloader \
      --no-scripts

COPY . .
COPY php.ini /usr/local/etc/php/conf.d/99-production.ini

RUN composer dump-autoload --optimize --classmap-authoritative

RUN mkdir -p storage/uploads storage/results \
    && chown -R www-data:www-data storage \
    && find storage -type d -exec chmod 0750 {} \; \
    && find storage -type f -exec chmod 0640 {} \; \
    && chmod +x /var/www/html/bin/entrypoint.sh

ENTRYPOINT ["/var/www/html/bin/entrypoint.sh"]
CMD ["php-fpm", "-F"]
